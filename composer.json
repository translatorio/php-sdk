{
    "name": "edulazaro/translatorio-sdk",
    "description": "The official PHP client for the Translatorio translation API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edu Lazaro",
            "homepage": "https://edulazaro.com"
        }
    ],
    "keywords": [
        "translation",
        "machine-translation",
        "localization",
        "i18n",
        "api",
        "client",
        "translatorio"
    ],
    "homepage": "https://translatorio.com/docs",
    "support": {
        "issues": "https://github.com/translatorio/php-sdk/issues",
        "source": "https://github.com/translatorio/php-sdk",
        "docs": "https://translatorio.com/docs"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Translatorio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Translatorio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
